#!/bin/sh
# Refuses a commit that adds a provenance comment or a path of the content folder.
# The brackets keep this file from matching itself.
found=$(git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++' | grep -E '<!--[[:space:]]*s[r]c:|One[D]rive')
if [ -n "$found" ]; then
  echo "Commit refused: it adds a provenance comment or a path of the content folder." >&2
  echo "$found" >&2
  exit 1
fi
